# ==============================================================================
# Monopoly Environment Template (Copy to .env and fill in values)
# ==============================================================================

# Cloudflare Worker Edge Firewall
CF_WORKER_URL=https://monopoly-edge-firewall.<your-subdomain>.workers.dev

# Origin URL (Địa chỉ backend Spring Boot mà Cloudflare Worker sẽ proxy tới)
ORIGIN_URL=http://localhost:8080

# Secret Key dùng cho cơ chế Origin Shielding (X-Origin-Verify)
ORIGIN_SECRET_KEY=your_generated_secret_key_here

# Spring Boot Configuration
APP_SECURITY_ORIGIN_PROTECTION_ENABLED=true
APP_SECURITY_ORIGIN_SECRET=your_generated_secret_key_here
